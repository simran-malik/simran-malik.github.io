---
import { Icon } from 'astro-icon/components';
import { site } from '../data';
---
<div class="links">
  <a class="icon-btn linkedin" href={site.linkedin} aria-label="LinkedIn" data-tip="LinkedIn" target="_blank" rel="noopener">
    <Icon name="mdi:linkedin" />
  </a>
  <a class="icon-btn github" href={site.github} aria-label="GitHub" data-tip="GitHub" target="_blank" rel="noopener">
    <Icon name="mdi:github" />
  </a>
  <a class="icon-btn email" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`} data-tip={site.email}>
    <Icon name="mdi:email-outline" />
  </a>
  <a class="pill" href={site.resume} data-tip="Resume (PDF)" target="_blank" rel="noopener">
    <Icon name="mdi:file-document-outline" />Resume
  </a>
</div>
