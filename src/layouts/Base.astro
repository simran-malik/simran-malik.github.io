---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { site } from '../data';

interface Props {
  title?: string;
  description?: string;
  snap?: boolean; // one-section-per-screen scrolling (home page)
}
// Analytics only runs on the live site, so your own local previews aren't counted.
const gaId = import.meta.env.PROD ? site.analyticsId : '';
const { title = `${site.name} — ${site.role}`, description = site.description, snap = false } = Astro.props;
---
<!doctype html>
<html lang="en" class={snap ? 'snap' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Hanken+Grotesk:wght@400;500&family=IBM+Plex+Mono:wght@500&display=swap"
    />
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
          // Count resume opens as their own event (works even when the PDF opens in a new tab).
          document.addEventListener('click', (e) => {
            const a = e.target.closest && e.target.closest('a[href$=".pdf"]');
            if (a) gtag('event', 'resume_download', { link_url: a.href, page_section: location.hash || '#top' });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <Header onHome={snap} />
    <slot />
  </body>
</html>
