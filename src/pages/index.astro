---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Links from '../components/Links.astro';
import { site, stats, publications, fun, funIntro, funSummary, contactForm } from '../data';

import { getPosts, formatDate } from '../lib/blog';
import photo from '../assets/simran.png';
import * as home from '../site-content/home.md';
import fs from 'node:fs';

// Work and project cards come from their own pages, so each is edited in one place.
// `order` sets the position on this page: 1 = first.
// Order comes from the drag-and-drop lists on the Homepage in Tina (workOrder / projectOrder);
// pages not in a list go at the end, sorted by their own `order` number.
const fileName = (path: string) => (path.split('/').pop() || '').replace('.md', '');
const fromPages = (mods: Record<string, any>, dir: string, list: any[] = []) => {
  const paths = (list ?? []).map((x: any) => (typeof x === 'string' ? x : x?.page) || '');
  const rank = (name: string) => { const i = paths.findIndex((p: string) => fileName(p) === name); return i === -1 ? Infinity : i; };
  return Object.entries(mods)
    .filter(([path]) => !fileName(path).startsWith('_'))
    .map(([path, mod]) => ({ ...mod.frontmatter, href: '/' + dir + '/' + fileName(path), name: fileName(path) }))
    .sort((a: any, b: any) => (rank(a.name) - rank(b.name)) || ((a.order ?? 999) - (b.order ?? 999)));
};
const work = fromPages(import.meta.glob('./work/*.md', { eager: true }), 'work', home.frontmatter.workOrder).map((j: any) => ({
  org: j.org ?? '', role: j.title ?? '', dates: j.dates ?? '', points: (j.points ?? []) as string[], href: j.href as string, logo: j.logo ?? '',
}));
const projects = fromPages(import.meta.glob('./projects/*.md', { eager: true }), 'projects', home.frontmatter.projectOrder).map((p: any) => ({
  title: p.title ?? '', summary: p.summary ?? '', stack: p.stack ?? '', cover: p.cover ?? '', image: p.image ?? '', href: p.href as string,
}));

const posts = await getPosts(2);
const bio = await home.compiledContent(); // the summary, edited in TinaCMS
const initial = (org: string) => org.trim().charAt(0);
// Finds public/logos/<name>.(svg|png|jpg|jpeg|webp); returns '' if there's no such file yet.
const logoFiles = fs.existsSync('public/logos') ? fs.readdirSync('public/logos') : [];
const logoFor = (name: string) => {
  const file = logoFiles.find((f) => /\.(svg|png|jpe?g|webp)$/i.test(f) && f.replace(/\.[^.]+$/, '') === name);
  return file ? `/logos/${file}` : '';
};
---
<Base snap>
  <main class="container">

    <section id="top" class="screen" style="gap: 32px">
      <div class="hero">
        <div class="hero-text">
          <span class="label">{site.role}</span>
          <h1>{site.name}</h1>
          <div class="bio" set:html={bio} />
        </div>
        <div class="hero-side">
          <Image class="photo" src={photo} alt={`Portrait of ${site.name}`} width={640} height={640} loading="eager" />
          <Links />
        </div>
      </div>
      <div class="stats">
        {stats.map((s) => <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>)}
      </div>
    </section>

    <section id="work" class="screen">
      <span class="label">Work</span>
      <div class="zz" style={`grid-template-rows: repeat(${work.length + 1}, minmax(84px, auto))`}>
        <div class="zz-line" aria-hidden="true"></div>
        {work.map((job, i) => {
          const Item = job.href ? 'a' : 'div';
          const src = logoFor(job.logo);
          const side = i % 2 === 0 ? 'left' : 'right';
          // "4+ years · Jul 2021 – Aug 2025" → duration + range (shown under the dot)
          const parts = job.dates.split(' · ');
          const range = parts.length > 1 ? parts.slice(1).join(' · ') : parts[0];
          const duration = parts.length > 1 ? parts[0] : '';
          return (
            <>
              <div class="zz-dot-cell" style={`--r: ${i + 1}`}>
                <div class="zz-dot" aria-hidden="true"></div>
                <div class="zz-when">
                  <span class="zz-range">{range}</span>
                  {duration && <span class="zz-dur">{duration}</span>}
                </div>
              </div>
              <Item class={`zz-item ${side}`} style={`--r: ${i + 1}`} {...(job.href ? { href: job.href } : {})}>
                <div class="zz-square">
                  {src ? <img src={src} alt="" /> : <span class="cover-word" aria-hidden="true">{job.org.split(/[\s·]+/)[0]}</span>}
                </div>
                <div class="zz-text">
                  <span class="kicker">{job.org.split(' · ').map((part, i) => <>{i > 0 && ' · '}<span class="nowrap">{part}</span></>)}</span>
                  <h3>{job.role}</h3>
                  <span class="meta zz-card-dates">{job.dates}</span>
                  {job.points[0] && <p>{job.points[0]}</p>}
                  {job.href && <span class="read-more">Read more →</span>}
                </div>
              </Item>
            </>
          );
        })}
      </div>
    </section>

    <section id="publications" class="screen">
      <span class="label">Publications</span>
      {publications.map((p) => (
        <article class="card pub">
          <div class="row section-head"><span class="kicker" style="font-size: 14px">{p.venue}</span><span class="meta">{p.status}</span></div>
          <h3>{p.title}</h3>
          <span class="authors">{p.authors}</span>
          <div class="two-col">{p.paragraphs.map((t) => <p>{t}</p>)}</div>
          <div class="pub-links">
            {p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} <Icon name="mdi:open-in-new" /></a>)}
            {p.pending && <span class="meta" style="font-weight: 400">{p.pending}</span>}
          </div>
        </article>
      ))}
    </section>

    <section id="projects" class="screen">
      <span class="label">Projects</span>
      <div class="grid grid-4">
        {projects.map((p) => (
          <a class="tile" href={p.href}>
            <div class="thumb">{p.image ? <img src={p.image} alt="" /> : <span class="cover-word" aria-hidden="true">{p.cover}</span>}</div>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <span class="tag">{p.stack}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="blog" class="screen">
      <div class="section-head">
        <span class="label">Blog</span>
        <a class="more" href={site.blog} target="_blank" rel="noopener">All posts ↗</a>
      </div>
      <div class="grid">
        {posts.map((post) => (
          <a class="tile" href={post.url} target="_blank" rel="noopener">
            <div class="thumb">{post.cover ? <img src={post.cover} alt="" loading="lazy" /> : 'Post cover image'}</div>
            <h3>{post.title}</h3>
            {post.subtitle && <p>{post.subtitle}</p>}
            <span class="tag">{[formatDate(post.date), post.readTime].filter(Boolean).join(' · ')}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="life" class="screen">
      <div class="section-head">
        <span class="label">Life</span>
        {funIntro && <span class="meta">{funIntro}</span>}
      </div>
      {funSummary && <p class="bio fun-summary">{funSummary}</p>}
      <div class="grid grid-4">
        {fun.map((f) => {
          const Tag = f.link ? 'a' : 'div';
          return (
            <Tag class="tile" {...(f.link ? { href: f.link, target: '_blank', rel: 'noopener' } : {})}>
              {f.image && <div class="thumb"><img src={f.image} alt="" loading="lazy" /></div>}
              <h3>{f.title}</h3>
              {f.note && <p>{f.note}</p>}
            </Tag>
          );
        })}
      </div>
    </section>

    <section id="contact" class="screen" style="gap: 36px">
      <span class="label">Contact</span>
      <div class="contact-grid">
        <div class="contact-intro">
          <p class="contact-line">{site.contactLine}</p>
          {site.contactNote && <p class="contact-note">{site.contactNote}</p>}
          <Links />
        </div>
        <form class="contact-form" id="contact-form" novalidate
          data-action={contactForm.action} data-f-name={contactForm.fields.name}
          data-f-email={contactForm.fields.email} data-f-message={contactForm.fields.message}
          data-mailto={site.email}>
          <div class="cf-row">
            <div class="cf-field">
              <label for="cf-name">Name<span class="cf-req" aria-hidden="true"> *</span></label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required aria-required="true" aria-describedby="cf-name-err" />
              <span class="cf-err" id="cf-name-err" aria-live="polite"></span>
            </div>
            <div class="cf-field">
              <label for="cf-email">Email<span class="cf-req" aria-hidden="true"> *</span></label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required aria-required="true" aria-describedby="cf-email-err" />
              <span class="cf-err" id="cf-email-err" aria-live="polite"></span>
            </div>
          </div>
          <div class="cf-field">
            <label for="cf-message">Message<span class="cf-req" aria-hidden="true"> *</span></label>
            <textarea id="cf-message" name="message" rows="6" required aria-required="true" aria-describedby="cf-message-err"></textarea>
            <span class="cf-err" id="cf-message-err" aria-live="polite"></span>
          </div>
          <div class="cf-trap" aria-hidden="true">
            <label for="cf-website">Leave this empty</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <span class="cf-legend"><span class="cf-req">*</span> Required</span>
          <button class="cf-send" type="submit">Send message</button>
          <p class="cf-status" role="status" aria-live="polite"></p>
        </form>
      </div>
      <span class="footer">© {new Date().getFullYear()} {site.name}</span>
    </section>

  </main>
</Base>

<script>
  // Keep the address bar (and the highlighted nav link) in sync with the section on screen.
  const sections = [...document.querySelectorAll<HTMLElement>('main > section[id]')];
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav a')];
  let current = '';

  const setActive = (id: string) => {
    if (id === current) return;
    current = id;
    const url = id === 'top' ? location.pathname + location.search : `#${id}`;
    history.replaceState(null, '', url);
    navLinks.forEach((a) => {
      if (a.getAttribute('href') === `#${id}`) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setActive(visible.target.id);
    },
    { threshold: [0.5, 0.75] }
  );
  sections.forEach((s) => observer.observe(s));
</script>

<script>
  // Contact form: checks the fields, then sends to the Google Form (or opens an email if none is set up yet).
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const showError = (id: string, msg: string) => {
      const input = $(id);
      const err = document.getElementById(`${id}-err`)!;
      err.textContent = msg;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };
    const status = form.querySelector('.cf-status')!;
    const button = form.querySelector('.cf-send') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $('cf-name').value.trim();
      const email = $('cf-email').value.trim();
      const message = $('cf-message').value.trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      showError('cf-email', !email ? 'Please add your email' : emailOk ? '' : 'Please enter a valid email');
      showError('cf-message', message ? '' : 'Please add a message');
      showError('cf-name', name ? '' : 'Please add your name');
      if (!name || !emailOk || !message) {
        (!name ? $('cf-name') : !emailOk ? $('cf-email') : $('cf-message')).focus();
        return;
      }
      if ($('cf-website').value) return; // spam trap: only bots fill this in

      const d = form.dataset;
      if (!d.action) {
        // No Google Form yet: open the visitor's email app with the message filled in.
        const body = `${message}\n\n— ${name} (${email})`;
        location.href = `mailto:${d.mailto}?subject=${encodeURIComponent('Hello from your website')}&body=${encodeURIComponent(body)}`;
        return;
      }
      const data = new FormData();
      data.append(d.fName!, name);
      data.append(d.fEmail!, email);
      data.append(d.fMessage!, message);
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        await fetch(d.action, { method: 'POST', mode: 'no-cors', body: data });
        form.innerHTML = '<p class="cf-thanks">Thanks! I\'ll get back to you soon.</p>';
      } catch {
        button.disabled = false;
        status.textContent = `Sorry, that didn't send. Please try again, or email me at ${d.mailto}.`;
      }
    });
  }
</script>
